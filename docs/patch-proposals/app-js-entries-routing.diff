目标文件：sciworkbench/public/app.js（集成负责人所有）
对应：第一组 2.4（列表→详情→返回、浏览历史、刷新恢复）；第三组 1（各页入口与返回）
现状：`navScrollPositions`（行 917-926）已保存每卷目滚动位置；但「打开详情」不入浏览历史，
浏览器后退不生效；刷新后详情失效只靠 refresh 兜底，不回到列表。

--- a/sciworkbench/public/app.js
+++ b/sciworkbench/public/app.js
@@ 新增：路由（哈希）——列表页与详情页，同一套对象校验
+// 卷目 → 详情 id 的 ui 字段名（与 material-list 的 data-* 对应）
+const DETAIL_ID_FIELD = { papers: "paperId", protocol: "protocolId", record: "executionId", analysis: "taskId", chat: "chatId", library: "assetId" };
+function currentDetailId() { const f = DETAIL_ID_FIELD[ui.nav]; return f ? ui[f] : null; }
+function routeHash() { return `#/${ui.nav}${currentDetailId() ? "/" + encodeURIComponent(currentDetailId()) : ""}`; }
+function pushDetailRoute() { if (location.hash !== routeHash()) history.pushState({ nav: ui.nav, id: currentDetailId() }, "", routeHash()); }
+function applyRoute() {
+  const m = location.hash.match(/^#\/([\w-]+)(?:\/(.+))?$/);
+  const nav = m && ["topic","papers","knowledge","protocol","record","analysis","chat","library"].includes(m[1]) ? m[1] : "topic";
+  const id = m ? decodeURIComponent(m[2] || "") : "";
+  if (nav !== ui.nav) guardLeave() && activateNav(nav);   // activateNav 已处理草稿与动画
+  const f = DETAIL_ID_FIELD[nav];
+  if (f && id) ui[f] = id;
+  renderAll();
+}
+window.addEventListener("popstate", applyRoute);

